#!/usr/bin/env bash

set -u

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly interval_seconds="${FREEZE_WATCH_INTERVAL_SECONDS:-10}"
readonly flush_every_samples=3
readonly docker_every_samples=3

# A sample that arrives this late means the machine stopped scheduling this
# loop, which is the closest a userspace process gets to observing a freeze
# from the inside.
readonly stall_threshold_seconds="${FREEZE_WATCH_STALL_SECONDS:-$((interval_seconds * 3))}"

# Trouble switches the log to write-through. The samples immediately before a
# freeze are the ones this tool exists to keep, and they are exactly the ones a
# page cache loses when the power is cut. These thresholds sit below the ones
# that raise a warning, so the evidence is already safe by the time anything is
# worth warning about.
readonly elevated_temp_mC=80000
readonly elevated_mem_available_kib=$((2 * 1024 * 1024))
readonly elevated_pressure=5.0

readonly journalctl_bin="${FREEZE_WATCH_JOURNALCTL:-journalctl}"
readonly kernel_every_samples=30
readonly kernel_alerts_per_scan=3

# Kernel messages that precede or explain a machine that stopped responding.
# The log is read to answer "why did it stop", not to audit the boot, so
# anything else is noise. journalctl is preferred over /dev/kmsg because it
# respects group permissions and can reach the boot before this one.
readonly kernel_alert_pattern='hung_task|blocked for more than [0-9]+ seconds|detected stalls? on CPU|INFO: rcu|GPU HANG|\[drm\].*(reset|hang|timeout)|ring [a-z0-9_.]+ timeout|nvme.*(timeout|controller is down|resetting)|[Mm]achine [Cc]heck|mce: \[Hardware Error\]|Out of memory: Kill|oom-kill:|above threshold, cpu clock throttled|EXT4-fs error|Buffer I/O error|ata[0-9]+\.[0-9]+: failed command'
readonly compose_project="${FREEZE_WATCH_COMPOSE_PROJECT:-}"
readonly max_samples="${FREEZE_WATCH_MAX_SAMPLES:-0}"
readonly state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/freeze-monitor"
readonly event_log="${state_dir}/events.log"

# Preference order, most specific driver first. A generic fallback such as
# acpitz is deliberately absent: it usually reports a board or ambient sensor,
# and a plausible but wrong CPU temperature is worse than none when the file is
# read back to explain a freeze.
readonly cpu_temp_sensors=(k10temp coretemp zenpower k8temp cpu_thermal)
readonly gpu_temp_sensors=(amdgpu radeon nouveau)

# Overridable so the test suite can present synthetic hardware, including a
# kernel built without pressure accounting.
readonly hwmon_root="${FREEZE_WATCH_HWMON_ROOT:-/sys/class/hwmon}"
readonly pressure_root="${FREEZE_WATCH_PRESSURE_ROOT:-/proc/pressure}"

mkdir -p "${state_dir}"
umask 077

exec 9>"${state_dir}/monitor.lock"
if ! flock -n 9; then
    exit 0
fi

boot_id="$(< /proc/sys/kernel/random/boot_id)"
start_stamp="$(date --iso-8601=seconds | tr ':' '-')"
log_date="$(date +%F)"
metrics_log="${state_dir}/metrics-${start_stamp}-${boot_id:0:8}.tsv"
docker_log="${state_dir}/docker-${start_stamp}-${boot_id:0:8}.tsv"

docker_state="not_sampled"
docker_container_count="NA"
docker_task_count="NA"
tracked_container_count="NA"
tracked_task_count="NA"
tracked_process_count="NA"
tracked_zombie_count="NA"
last_docker_state=""
last_docker_alert=""
kernel_log_state="unknown"
kernel_cursor=""
last_kernel_alert=""
kernel_alert_seen=0
scan_previous_boot=0

# Accepts several driver names and returns the first one present, so the
# argument order expresses preference rather than whatever order the kernel
# happened to number the hwmon devices in.
read_hwmon_temp() {
    local wanted_name
    local hwmon_dir
    local actual_name
    local value

    for wanted_name in "$@"; do
        for hwmon_dir in "${hwmon_root}"/hwmon*; do
            [[ -r "${hwmon_dir}/name" ]] || continue
            actual_name="$(< "${hwmon_dir}/name")"
            [[ "${actual_name}" == "${wanted_name}" ]] || continue

            if [[ -r "${hwmon_dir}/temp1_input" ]]; then
                value="$(< "${hwmon_dir}/temp1_input")"
                if [[ "${value}" =~ ^-?[0-9]+$ ]]; then
                    printf '%s' "${value}"
                    return
                fi
            fi
        done
    done

    printf 'NA'
}

read_gpu_busy() {
    local busy_file
    local value

    for busy_file in /sys/class/drm/card*/device/gpu_busy_percent; do
        [[ -r "${busy_file}" ]] || continue
        value="$(< "${busy_file}")"
        if [[ "${value}" =~ ^[0-9]+$ ]]; then
            printf '%s' "${value}"
            return
        fi
    done

    printf 'NA'
}

read_pressure_avg10() {
    local pressure_file="$1"

    awk '
        /^some / {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^avg10=/) {
                    sub(/^avg10=/, "", $i)
                    print $i
                    exit
                }
            }
        }
    ' "${pressure_file}" 2>/dev/null
}

record_docker_sample() {
    local timestamp="$1"
    local epoch="$2"
    local stats_output
    local project_output
    local container_name
    local cpu_pct
    local mem_usage
    local tasks
    local is_tracked
    local inspect_output
    local oom_killed
    local restart_count
    local top_output
    local process_count
    local zombie_count
    local alert=""
    local name
    declare -A tracked_names=()

    docker_state="unavailable"
    docker_container_count=0
    docker_task_count=0
    tracked_container_count=0
    tracked_task_count=0
    tracked_process_count=0
    tracked_zombie_count=0

    if ! command -v docker >/dev/null 2>&1; then
        docker_state="not_installed"
    elif ! stats_output="$(
        timeout 5s docker stats --no-stream \
            --format '{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.PIDs}}' \
            2>/dev/null
    )"; then
        docker_state="unavailable"
    else
        docker_state="ok"
        project_output=""
        if [[ -n "${compose_project}" ]]; then
            project_output="$(
                timeout 3s docker ps \
                    --filter "label=com.docker.compose.project=${compose_project}" \
                    --format '{{.Names}}' 2>/dev/null
            )" || project_output=""
        fi

        while IFS= read -r name; do
            [[ -n "${name}" ]] || continue
            tracked_names["${name}"]=1
        done <<< "${project_output}"

        while IFS=$'\t' read -r container_name cpu_pct mem_usage tasks; do
            [[ -n "${container_name}" ]] || continue
            tasks="${tasks:-0}"
            is_tracked=0
            oom_killed="NA"
            restart_count="NA"
            process_count="NA"
            zombie_count="NA"

            docker_container_count=$((docker_container_count + 1))
            if [[ "${tasks}" =~ ^[0-9]+$ ]]; then
                docker_task_count=$((docker_task_count + tasks))
            fi

            if [[ -n "${tracked_names[${container_name}]+set}" ]]; then
                is_tracked=1
                tracked_container_count=$((tracked_container_count + 1))
                if [[ "${tasks}" =~ ^[0-9]+$ ]]; then
                    tracked_task_count=$((tracked_task_count + tasks))
                fi

                inspect_output="$(
                    timeout 3s docker inspect \
                        -f '{{.State.OOMKilled}}|{{.RestartCount}}' \
                        "${container_name}" 2>/dev/null
                )" || inspect_output="NA|NA"
                IFS='|' read -r oom_killed restart_count <<< "${inspect_output}"

                top_output="$(
                    timeout 3s docker top "${container_name}" -eo pid,stat 2>/dev/null
                )" || top_output=""
                if [[ -n "${top_output}" ]]; then
                    read -r process_count zombie_count < <(
                        awk '
                            NR > 1 && NF > 0 {
                                processes++
                                if ($2 ~ /^Z/) zombies++
                            }
                            END { print processes + 0, zombies + 0 }
                        ' <<< "${top_output}"
                    )
                    tracked_process_count=$((tracked_process_count + process_count))
                    tracked_zombie_count=$((tracked_zombie_count + zombie_count))
                fi

                if [[ "${zombie_count}" =~ ^[0-9]+$ ]] && (( zombie_count > 0 )); then
                    alert+="${container_name}:zombies=${zombie_count};"
                fi
                if [[ "${oom_killed}" == "true" ]]; then
                    alert+="${container_name}:oom=true;"
                fi
                if [[ "${restart_count}" =~ ^[0-9]+$ ]] && (( restart_count > 0 )); then
                    alert+="${container_name}:restarts=${restart_count};"
                fi
            fi

            mem_usage="${mem_usage//$'\t'/ }"
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "${timestamp}" "${epoch}" "${container_name}" \
                "${is_tracked}" "${cpu_pct}" "${mem_usage}" "${tasks}" \
                "${process_count}" "${zombie_count}" \
                "${oom_killed}" "${restart_count}" >> "${docker_log}"
        done <<< "${stats_output}"
    fi

    if [[ "${docker_state}" != "${last_docker_state}" ]]; then
        printf '%s\tINFO\tDocker monitor state: %s\n' \
            "${timestamp}" "${docker_state}" >> "${event_log}"
        last_docker_state="${docker_state}"
    fi

    if [[ -n "${alert}" && "${alert}" != "${last_docker_alert}" ]]; then
        printf '%s\tWARN\tDocker anomaly: %s\n' \
            "${timestamp}" "${alert}" >> "${event_log}"
    fi
    last_docker_alert="${alert}"
}

record_event_if_needed() {
    local timestamp="$1"
    local cpu_temp="$2"
    local gpu_temp="$3"
    local mem_available_kib="$4"
    local io_pressure="$5"

    if [[ "${cpu_temp}" != "NA" ]] && (( cpu_temp >= 90000 )); then
        printf '%s\tWARN\tCPU temperature %.1f C\n' \
            "${timestamp}" "$((cpu_temp / 100))e-1" >> "${event_log}"
    fi

    if [[ "${gpu_temp}" != "NA" ]] && (( gpu_temp >= 90000 )); then
        printf '%s\tWARN\tGPU temperature %.1f C\n' \
            "${timestamp}" "$((gpu_temp / 100))e-1" >> "${event_log}"
    fi

    if (( mem_available_kib < 1048576 )); then
        printf '%s\tWARN\tAvailable memory below 1 GiB: %s KiB\n' \
            "${timestamp}" "${mem_available_kib}" >> "${event_log}"
    fi

    # The + 0 forces a numeric comparison. Without it a kernel built without
    # pressure accounting reports NA, awk compares strings, "NA" sorts above
    # "20.0", and every single sample raises a warning.
    if awk -v value="${io_pressure}" 'BEGIN { exit !(value + 0 >= 20.0) }'; then
        printf '%s\tWARN\tI/O pressure avg10 is %s\n' \
            "${timestamp}" "${io_pressure}" >> "${event_log}"
    fi
}

kernel_log_available() {
    command -v "${journalctl_bin}" >/dev/null 2>&1 &&
        "${journalctl_bin}" -k -n 0 >/dev/null 2>&1
}

read_kernel_cursor() {
    "${journalctl_bin}" -k -n 0 --show-cursor 2>/dev/null |
        sed -n 's/^-- cursor: //p'
}

# Reports the interesting kernel lines produced by the given journalctl
# arguments. Output is capped because one failing device can produce thousands
# of near-identical lines, and a log that scrolls past the freeze is no better
# than no log.
scan_kernel_log() {
    local timestamp="$1"
    local prefix="$2"
    shift 2
    local line
    local count=0

    while IFS= read -r line; do
        [[ -n "${line}" ]] || continue
        line="${line//$'\t'/ }"
        line="${line:0:200}"
        [[ "${line}" == "${last_kernel_alert}" ]] && continue
        last_kernel_alert="${line}"
        kernel_alert_seen=1
        printf '%s\tKERNEL\t%s%s\n' \
            "${timestamp}" "${prefix}" "${line}" >> "${event_log}"
        count=$((count + 1))
        ((count >= kernel_alerts_per_scan)) && break
    done < <(
        "${journalctl_bin}" "$@" -o cat --no-pager 2>/dev/null |
            grep -aE "${kernel_alert_pattern}" || true
    )
}

sample_is_elevated() {
    local cpu_temp="$1"
    local gpu_temp="$2"
    local mem_available_kib="$3"
    local memory_pressure="$4"
    local io_pressure="$5"

    if [[ "${cpu_temp}" != "NA" ]] && (( cpu_temp >= elevated_temp_mC )); then
        return 0
    fi

    if [[ "${gpu_temp}" != "NA" ]] && (( gpu_temp >= elevated_temp_mC )); then
        return 0
    fi

    if (( mem_available_kib < elevated_mem_available_kib )); then
        return 0
    fi

    awk -v memory="${memory_pressure}" -v io="${io_pressure}" \
        -v threshold="${elevated_pressure}" \
        'BEGIN { exit !(memory + 0 >= threshold || io + 0 >= threshold) }'
}

# A new session's first job is to decide how the previous one ended, because
# nothing else in the logs says where a freeze happened. A session that never
# wrote STOP was cut off. A different boot id then means the machine went down
# without shutting down, which is what a forced reboot looks like; the same
# boot id means only the collector died while the machine kept running.
report_previous_session() {
    local timestamp="$1"
    local now_epoch="$2"
    local last_record previous_type previous_boot previous_metrics
    local last_sample="" last_epoch="" silence=""

    [[ -r "${event_log}" ]] || return 0

    last_record="$(
        awk -F'\t' '$2 == "START" || $2 == "STOP" { line = $0 } END { print line }' \
            "${event_log}"
    )"
    [[ -n "${last_record}" ]] || return 0

    previous_type="$(printf '%s' "${last_record}" | cut -f2)"
    [[ "${previous_type}" == "START" ]] || return 0

    previous_boot="$(printf '%s' "${last_record}" | sed -n 's/.*boot=\([^ ]*\).*/\1/p')"
    previous_metrics="$(printf '%s' "${last_record}" | sed -n 's/.*metrics=\([^ ]*\).*/\1/p')"

    if [[ -n "${previous_metrics}" && -r "${previous_metrics}" ]]; then
        read -r last_sample last_epoch < <(
            awk -F'\t' '
                NR > 1 && NF > 2 { stamp = $1; stamp_epoch = $2 }
                END { print stamp, stamp_epoch }
            ' "${previous_metrics}"
        )
    fi

    last_sample="${last_sample:-unknown}"
    # A clock that stepped backwards, over NTP or across an RTC the firmware
    # rewrote, would otherwise report a negative silence.
    if [[ "${last_epoch}" =~ ^[0-9]+$ ]] && (( now_epoch >= last_epoch )); then
        silence=" silent_for=$((now_epoch - last_epoch))s"
    fi

    if [[ "${previous_boot}" != "${boot_id}" ]]; then
        # Only an unclean reboot justifies reading the previous boot's kernel
        # log. Doing it on every restart would replay the same lines forever.
        scan_previous_boot=1
        printf '%s\tFREEZE\tprevious session ended without shutting down; last_sample=%s%s metrics=%s\n' \
            "${timestamp}" "${last_sample}" "${silence}" \
            "${previous_metrics:-unknown}" >> "${event_log}"
    else
        printf '%s\tINTERRUPTED\tcollector stopped without notice while the machine stayed up; last_sample=%s%s\n' \
            "${timestamp}" "${last_sample}" "${silence}" >> "${event_log}"
    fi
}

write_log_headers() {
    printf 'timestamp\tepoch\tuptime_s\tload1\tload5\tload15\tmem_available_kib\tswap_used_kib\troot_used_pct\tcpu_temp_mC\tgpu_temp_mC\tnvme_temp_mC\tgpu_busy_pct\tcpu_psi_avg10\tmemory_psi_avg10\tio_psi_avg10\tdocker_state\tdocker_containers\tdocker_tasks\ttracked_containers\ttracked_tasks\ttracked_processes\ttracked_zombies\ttop_processes\n' > "${metrics_log}"
    printf 'timestamp\tepoch\tcontainer\tis_tracked_project\tcpu_pct\tmemory_usage\ttasks\tprocesses\tzombies\toom_killed\trestart_count\n' > "${docker_log}"
}

rotate_logs_if_needed() {
    local today
    local rotate_timestamp
    local rotate_stamp
    local old_metrics_log
    local old_docker_log

    today="$(date +%F)"
    [[ "${today}" != "${log_date}" ]] || return

    rotate_timestamp="$(date --iso-8601=seconds)"
    rotate_stamp="${rotate_timestamp//:/-}"
    old_metrics_log="${metrics_log}"
    old_docker_log="${docker_log}"
    sync -d "${old_metrics_log}" "${old_docker_log}" "${event_log}" 2>/dev/null || true

    log_date="${today}"
    metrics_log="${state_dir}/metrics-${rotate_stamp}-${boot_id:0:8}.tsv"
    docker_log="${state_dir}/docker-${rotate_stamp}-${boot_id:0:8}.tsv"
    write_log_headers

    printf '%s\tROTATE\tmetrics=%s docker=%s\n' \
        "${rotate_timestamp}" "${metrics_log}" "${docker_log}" >> "${event_log}"
    sync -d "${metrics_log}" "${docker_log}" "${event_log}" 2>/dev/null || true
}

on_exit() {
    local exit_timestamp

    exit_timestamp="$(date --iso-8601=seconds)"
    printf '%s\tSTOP\tmonitor stopped\n' "${exit_timestamp}" >> "${event_log}"
    sync -d "${metrics_log}" "${docker_log}" "${event_log}" 2>/dev/null || true
}

on_signal() {
    exit 0
}

trap on_exit EXIT
trap on_signal INT TERM

write_log_headers
start_timestamp="$(date --iso-8601=seconds)"
report_previous_session "${start_timestamp}" "$(date +%s)"

if kernel_log_available; then
    kernel_log_state="ok"
    kernel_cursor="$(read_kernel_cursor)"
    if ((scan_previous_boot == 1)); then
        scan_kernel_log "${start_timestamp}" "previous boot: " -k -b -1
    fi
else
    kernel_log_state="unavailable"
    printf '%s\tINFO\tkernel log unavailable; add this user to the adm or systemd-journal group\n' \
        "${start_timestamp}" >> "${event_log}"
fi
printf '%s\tSTART\tboot=%s metrics=%s interval=%ss flush=%ss\n' \
    "${start_timestamp}" "${boot_id}" "${metrics_log}" \
    "${interval_seconds}" "$((interval_seconds * flush_every_samples))" \
    >> "${event_log}"
sync -d "${metrics_log}" "${event_log}" 2>/dev/null || true

sample_count=0
previous_epoch=""
write_through=0

while true; do
    rotate_logs_if_needed
    timestamp="$(date --iso-8601=seconds)"
    epoch="$(date +%s)"

    # A late sample is evidence in its own right. If these keep arriving on
    # time through a reported freeze then the kernel stayed alive and the
    # desktop is what stopped responding, which is a different investigation.
    stalled=0
    if [[ -n "${previous_epoch}" ]] &&
       (( epoch - previous_epoch >= stall_threshold_seconds )); then
        stalled=1
        printf '%s\tGAP\tsampling stalled for %ss, expected %ss\n' \
            "${timestamp}" "$((epoch - previous_epoch))" "${interval_seconds}" \
            >> "${event_log}"
    fi
    previous_epoch="${epoch}"

    uptime_seconds="$(awk '{ print int($1) }' /proc/uptime)"
    read -r load1 load5 load15 _ < /proc/loadavg

    read -r mem_available_kib swap_total_kib swap_free_kib < <(
        awk '
            /^MemAvailable:/ { mem_available = $2 }
            /^SwapTotal:/ { swap_total = $2 }
            /^SwapFree:/ { swap_free = $2 }
            END { print mem_available + 0, swap_total + 0, swap_free + 0 }
        ' /proc/meminfo
    )
    swap_used_kib=$((swap_total_kib - swap_free_kib))

    root_used_pct="$(
        df -P / 2>/dev/null |
            awk 'NR == 2 { gsub(/%/, "", $5); print $5 }'
    )"
    root_used_pct="${root_used_pct:-NA}"

    cpu_temp="$(read_hwmon_temp "${cpu_temp_sensors[@]}")"
    gpu_temp="$(read_hwmon_temp "${gpu_temp_sensors[@]}")"
    nvme_temp="$(read_hwmon_temp nvme)"
    gpu_busy="$(read_gpu_busy)"

    cpu_pressure="$(read_pressure_avg10 "${pressure_root}/cpu")"
    memory_pressure="$(read_pressure_avg10 "${pressure_root}/memory")"
    io_pressure="$(read_pressure_avg10 "${pressure_root}/io")"
    cpu_pressure="${cpu_pressure:-NA}"
    memory_pressure="${memory_pressure:-NA}"
    io_pressure="${io_pressure:-NA}"

    top_processes="$(
        ps -eo comm=,%cpu=,%mem= --sort=-%cpu 2>/dev/null |
            head -5 |
            awk '
                {
                    gsub(/[[:space:]]+/, " ", $0)
                    sub(/^ /, "", $0)
                    if (NR > 1) {
                        printf ";"
                    }
                    printf "%s", $0
                }
            '
    )"
    top_processes="${top_processes//$'\t'/ }"

    if (( sample_count % docker_every_samples == 0 )); then
        record_docker_sample "${timestamp}" "${epoch}"
    fi

    kernel_alert_seen=0
    if [[ "${kernel_log_state}" == "ok" ]] &&
       (( sample_count % kernel_every_samples == 0 )); then
        scan_kernel_log "${timestamp}" "" -k --after-cursor "${kernel_cursor}"
        kernel_cursor="$(read_kernel_cursor)"
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${timestamp}" "${epoch}" "${uptime_seconds}" \
        "${load1}" "${load5}" "${load15}" \
        "${mem_available_kib}" "${swap_used_kib}" "${root_used_pct}" \
        "${cpu_temp}" "${gpu_temp}" "${nvme_temp}" "${gpu_busy}" \
        "${cpu_pressure}" "${memory_pressure}" "${io_pressure}" \
        "${docker_state}" "${docker_container_count}" "${docker_task_count}" \
        "${tracked_container_count}" "${tracked_task_count}" \
        "${tracked_process_count}" "${tracked_zombie_count}" \
        "${top_processes}" >> "${metrics_log}"

    record_event_if_needed \
        "${timestamp}" "${cpu_temp}" "${gpu_temp}" \
        "${mem_available_kib}" "${io_pressure}"

    if ((stalled == 1)) || ((kernel_alert_seen == 1)) || sample_is_elevated \
        "${cpu_temp}" "${gpu_temp}" "${mem_available_kib}" \
        "${memory_pressure}" "${io_pressure}"; then
        if ((write_through == 0)); then
            write_through=1
            printf '%s\tFLUSH\tconditions elevated, writing every sample through\n' \
                "${timestamp}" >> "${event_log}"
        fi
    elif ((write_through == 1)); then
        write_through=0
        printf '%s\tFLUSH\tconditions normal, resuming buffered writes\n' \
            "${timestamp}" >> "${event_log}"
    fi

    sample_count=$((sample_count + 1))
    if ((write_through == 1)) || (( sample_count % flush_every_samples == 0 )); then
        sync -d "${metrics_log}" "${docker_log}" "${event_log}" 2>/dev/null || true
    fi
    if [[ "${max_samples}" =~ ^[0-9]+$ ]] &&
       (( max_samples > 0 && sample_count >= max_samples )); then
        break
    fi

    sleep "${interval_seconds}"
done
