#!/usr/bin/env bash

set -u

readonly data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly env_file="${config_home}/freeze-watch/env"

# The installer records the interpreter it verified. Reading it here keeps the
# dashboard working from a shell whose PATH resolves python3 to a version
# manager shim without the system GTK and dbus bindings.
python_bin="${FREEZE_WATCH_PYTHON:-}"

if [[ -z "${python_bin}" && -r "${env_file}" ]]; then
    python_bin="$(awk '
        /^FREEZE_WATCH_PYTHON=/ {
            value = $0
            sub(/^FREEZE_WATCH_PYTHON=/, "", value)
        }
        END { print value }
    ' "${env_file}")"
fi

if [[ -z "${python_bin}" ]] || ! command -v "${python_bin}" >/dev/null 2>&1; then
    python_bin="python3"
fi

exec "${python_bin}" "${data_home}/freeze-watch/freeze_watch.py" "$@"
